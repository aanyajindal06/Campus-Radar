# Local development defaults. Set real values in Render's Environment tab.
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite:///./campusfind.db
# With a Render persistent disk mounted at /var/data:
# DATABASE_URL=sqlite:////var/data/campusfind.db
# UPLOAD_DIR=/var/data/uploads
# QR_DIR=/var/data/qrcodes
