# Local development; copy this file to backend/.env.
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./campusfind.db
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://127.0.0.1:3000
CORS_ORIGIN_REGEX=
SEED_DEMO_DATA=true
MAX_UPLOAD_MB=5
MAX_IMAGES_PER_ITEM=5
# Render: ENVIRONMENT=production, a unique SECRET_KEY, PostgreSQL DATABASE_URL,
# and FRONTEND_URL=https://YOUR-PROJECT.vercel.app (no path).
