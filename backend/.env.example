# Production backend configuration for Render.
# With render.yaml, Render generates SECRET_KEY and sets DATABASE_URL automatically.
# For manual setup, copy SECRET_KEY from the private backend/.env.render file.
# Add DATABASE_URL from Render PostgreSQL > Connect > Internal Database URL.
# Add FRONTEND_URL after Vercel assigns the frontend domain.
PYTHON_VERSION=3.12.8
ENVIRONMENT=production
CORS_ORIGINS=
CORS_ORIGIN_REGEX=
SEED_DEMO_DATA=true
MAX_UPLOAD_MB=5
MAX_IMAGES_PER_ITEM=5
