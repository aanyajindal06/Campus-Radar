# ---------- Frontend (Vercel -> Project Settings -> Environment Variables) ----------
# Public URL of the backend API, including /api/v1 (no trailing slash).
# Local: http://localhost:8000/api/v1   Production: https://YOUR-API.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ---------- Backend (Render -> Environment) ----------
# development | production. In production SECRET_KEY must be set.
ENVIRONMENT=development

# Long random string used to sign login tokens. Never commit the real one.
SECRET_KEY=change-me-to-a-long-random-string

# Database. Leave unset locally to use SQLite (backend/campusfind.db).
# Production (Render Postgres): postgresql://USER:PASSWORD@HOST:5432/DBNAME
# render.yaml fills this in automatically from the campusradar-db database.
DATABASE_URL=sqlite:///./campusfind.db

# CORS: exact origins allowed to call the API, comma separated, no trailing slash.
# Production: set FRONTEND_URL to your exact Vercel origin. Extra allowed origins are optional.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=
# Optional: allow Vercel preview deployments, e.g. https://campusradar-.*\.vercel\.app
CORS_ORIGIN_REGEX=

# Photo uploads are stored in the database (survive Render restarts/redeploys).
MAX_UPLOAD_MB=5
MAX_IMAGES_PER_ITEM=5

# Load the ABES demo accounts and items on first start (true/false).
SEED_DEMO_DATA=true
